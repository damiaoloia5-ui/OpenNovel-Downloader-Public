{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenNovel Downloader",
  "version": "0.3.17",
  "identifier": "org.opennovel.downloader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "create": false, "title": "OpenNovel Downloader", "width": 1120, "height": 780, "minWidth": 760, "minHeight": 560 }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'none'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "license": "Apache-2.0",
    "licenseFile": "../../../LICENSE",
    "resources": {"../../../LICENSE":"LICENSE"},
    "windows": {"nsis":{"installMode":"currentUser","languages":["SimpChinese","English"],"displayLanguageSelector":false},"webviewInstallMode":{"type":"downloadBootstrapper","silent":true}}
  }
}
