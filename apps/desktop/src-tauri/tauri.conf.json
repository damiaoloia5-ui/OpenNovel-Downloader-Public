{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenNovel Downloader",
  "version": "0.3.21",
  "identifier": "org.opennovel.downloader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "OpenNovel Downloader",
        "width": 1120,
        "height": 780,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "license": "Apache-2.0",
    "licenseFile": "../../../LICENSE",
    "resources": {
      "../../../LICENSE": "LICENSE"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFMTgxMjRGNDc3NDZENjkKUldScGJYUkhUeElZcmxvQktGNElSaU1iWlpwZ0tqZUhnc01VS1c1TjNFWTJRZFZpVTk3bnhpVEYK",
      "endpoints": [
        "https://github.com/damiaoloia5-ui/OpenNovel-Downloader-Public/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "allowDowngrades": false,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
