{
  "name": "opennovel-downloader",
  "version": "0.3.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/desktop"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "npm run dev --workspace @opennovel/desktop",
    "lint": "eslint apps/desktop/src apps/desktop/vite.config.ts",
    "typecheck": "npm run typecheck --workspace @opennovel/desktop",
    "test": "cargo test --workspace",
    "build": "npm run build --workspace @opennovel/desktop",
    "desktop:dev": "npm run tauri --workspace @opennovel/desktop -- dev",
    "desktop:build": "npm run tauri --workspace @opennovel/desktop -- build --no-bundle",
    "release:notices": "node scripts/release-notices.mjs",
    "desktop:package": "npm run release:notices && npm run tauri --workspace @opennovel/desktop -- build --config src-tauri/tauri.installer.conf.json --bundles nsis"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.0.0",
    "typescript-eslint": "^8.0.0",
    "vue-eslint-parser": "^10.0.0"
  }
}
